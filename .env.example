APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Domain FE (Nuxt), dùng cho link trong email xác thực / quên mật khẩu
FRONTEND_URL=http://localhost:3000

FFMPEG_BIN=/usr/bin/ffmpeg

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---- Lưu HLS trên Cloudflare R2 + phát qua Worker (cloudflare/video-cdn) ----
# local = như cũ (PHP phát từ storage/app); r2 = video encode MỚI sẽ lên R2.
VIDEO_HLS_DISK=local
VIDEO_CDN_URL=https://cdn.example.com
# Ít nhất 32 ký tự, PHẢI giống STREAM_SECRET của Worker. Tạo: openssl rand -base64 48
VIDEO_STREAM_SECRET=
# Origin của FE được lấy khóa AES, cách nhau dấu phẩy.
VIDEO_ALLOWED_ORIGINS=https://app.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ffmpeg-videos
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# ID của password grant client (public), tạo bằng: php artisan passport:client --password --public
PASSPORT_PASSWORD_CLIENT_ID=
